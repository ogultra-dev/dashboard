<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= name %> — OgUltra Dash</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <% /* favicon / logo */ %>
    <% if (typeof settings !== 'undefined' && settings && settings.favicon) { %>
        <link rel="icon" href="/assets/favicon.png" type="image/png">
    <% } else if (typeof settings !== 'undefined' && settings && settings.logo) { %>
        <link rel="icon" href="/assets/logo.png" type="image/png">
    <% } else { %>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%236d28d9'/><text x='50%25' y='56%25' font-family='Arial' font-size='18' font-weight='bold' fill='white' text-anchor='middle' dominant-baseline='middle'>O</text></svg>">
    <% } %>

    <style>
        :root {
            --bg:       #07060f;
            --bg2:      #0d0b1a;
            --bg3:      #131124;
            --surface:  rgba(255,255,255,0.04);
            --surface2: rgba(255,255,255,0.07);
            --border:   rgba(255,255,255,0.07);
            --border2:  rgba(139,92,246,0.25);
            --accent:   #8b5cf6;
            --accent2:  #a78bfa;
            --accent3:  #6d28d9;
            --text:     rgba(220,210,255,0.9);
            --text2:    rgba(180,165,230,0.6);
            --text3:    rgba(150,135,200,0.4);
            --green:    #10b981;
            --red:      #ef4444;
            --yellow:   #f59e0b;
            --gold:     #fbbf24;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── Video background ── */
        #og-bg-video {
            position: fixed; inset: 0;
            width: 100%; height: 100%;
            object-fit: cover;
            z-index: 0;
            opacity: 0;
            transition: opacity 1.2s ease;
        }
        #og-bg-video.ready { opacity: 1; }
        .og-bg-overlay {
            position: fixed; inset: 0; z-index: 1;
            background: linear-gradient(135deg, rgba(7,6,15,0.88) 0%, rgba(15,8,30,0.82) 100%);
            backdrop-filter: blur(0.5px);
        }
        /* fallback ambient glow when no video */
        .og-ambient {
            position: fixed; top: -20%; left: 50%; transform: translateX(-50%);
            width: 900px; height: 500px;
            background: radial-gradient(ellipse, rgba(109,40,217,0.14) 0%, transparent 70%);
            z-index: 2; pointer-events: none;
        }

        /* ── Layout ── */
        .og-layout { display: flex; min-height: 100vh; position: relative; z-index: 3; }

        /* ── Sidebar ── */
        .og-sidebar {
            width: 230px;
            flex-shrink: 0;
            background: rgba(7,6,15,0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 20px 12px;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            overflow-y: auto;
            z-index: 50;
            transition: transform 0.25s ease;
        }
        .og-sidebar::-webkit-scrollbar { width: 3px; }
        .og-sidebar::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.2); border-radius: 99px; }

        /* brand */
        .og-brand {
            display: flex; align-items: center; gap: 10px;
            padding: 4px 8px 20px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 12px;
        }
        .og-brand-icon {
            width: 34px; height: 34px; border-radius: 9px;
            background: linear-gradient(135deg, #6d28d9, #8b5cf6);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700; font-size: 16px; color: #fff;
            box-shadow: 0 0 18px rgba(139,92,246,0.35);
            flex-shrink: 0; overflow: hidden;
        }
        .og-brand-icon img { width: 100%; height: 100%; object-fit: cover; border-radius: 9px; }
        .og-brand-name {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600; font-size: 15px;
            background: linear-gradient(90deg, #c4b5fd, #a78bfa);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* coins */
        .og-coins {
            display: inline-flex; align-items: center; gap: 5px;
            font-size: 12px; font-weight: 500;
            color: var(--gold); margin-bottom: 16px;
            padding: 5px 10px; border-radius: 20px;
            background: rgba(251,191,36,0.08);
            border: 1px solid rgba(251,191,36,0.15);
        }

        /* nav */
        .og-nav-section { font-size: 10px; font-weight: 600; color: var(--text3); text-transform: uppercase; letter-spacing: .08em; padding: 4px 8px; margin-bottom: 4px; margin-top: 8px; }
        .og-nav-link {
            display: flex; align-items: center; gap: 9px;
            padding: 9px 10px; border-radius: 9px;
            font-size: 13px; font-weight: 500;
            color: var(--text2); text-decoration: none;
            transition: all .18s ease;
            border: 1px solid transparent;
            margin-bottom: 2px;
        }
        .og-nav-link svg { width: 16px; height: 16px; flex-shrink: 0; opacity: .7; }
        .og-nav-link:hover { color: var(--text); background: var(--surface2); border-color: var(--border); }
        .og-nav-link:hover svg { opacity: 1; }
        .og-nav-link.active { color: var(--accent2); background: rgba(139,92,246,0.1); border-color: rgba(139,92,246,0.2); }
        .og-nav-link.active svg { opacity: 1; }
        .og-nav-badge { margin-left: auto; font-size: 10px; padding: 1px 6px; border-radius: 20px; font-weight: 600; background: rgba(239,68,68,0.12); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }

        /* user card at bottom */
        .og-user-card {
            margin-top: auto; padding: 12px; border-radius: 11px;
            background: var(--surface); border: 1px solid var(--border);
            display: flex; align-items: center; gap: 10px;
        }
        .og-user-avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(139,92,246,0.25); flex-shrink: 0; }
        .og-user-name { font-size: 13px; font-weight: 500; color: var(--text); }
        .og-user-tag  { font-size: 11px; color: var(--text3); }
        .og-logout-btn {
            margin-left: auto; width: 28px; height: 28px; border-radius: 7px;
            background: none; border: 1px solid var(--border); cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            color: var(--text3); text-decoration: none; transition: all .18s; flex-shrink: 0;
        }
        .og-logout-btn:hover { color: #f87171; border-color: rgba(239,68,68,0.3); background: rgba(239,68,68,0.08); }

        /* ── Mobile header ── */
        .og-mobile-header {
            display: none;
            position: fixed; top: 0; left: 0; right: 0; height: 56px;
            background: rgba(7,6,15,0.9); backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            z-index: 60; align-items: center; padding: 0 16px; gap: 12px;
        }
        .og-hamburger { background: none; border: none; color: var(--text2); cursor: pointer; padding: 4px; }
        .og-mobile-brand { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; color: var(--accent2); flex: 1; }

        @media (max-width: 768px) {
            .og-mobile-header { display: flex; }
            .og-sidebar { transform: translateX(-100%); }
            .og-sidebar.open { transform: translateX(0); }
            .og-main { margin-left: 0 !important; padding-top: 56px; }
            .og-sidebar-overlay { display: block !important; }
        }

        .og-sidebar-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.5); z-index: 45; backdrop-filter: blur(2px);
        }

        /* ── Main content ── */
        .og-main { flex: 1; margin-left: 230px; min-height: 100vh; }

        /* ── Cards ── */
        .card {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            border-radius: 14px;
            backdrop-filter: blur(8px);
        }
        .card-accent {
            background: rgba(109,40,217,0.06);
            border: 1px solid rgba(139,92,246,0.15);
            border-radius: 14px;
        }

        /* ── Buttons ── */
        .btn { display: inline-flex; align-items: center; gap: 7px; padding: 8px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 500; cursor: pointer; transition: all .18s; border: 1px solid transparent; text-decoration: none; font-family: 'Inter', sans-serif; }
        .btn-primary { background: linear-gradient(135deg, #6d28d9, #8b5cf6); color: #fff; border-color: rgba(139,92,246,0.4); box-shadow: 0 4px 14px rgba(109,40,217,0.25); }
        .btn-primary:hover { background: linear-gradient(135deg, #7c3aed, #9f7aea); box-shadow: 0 4px 20px rgba(109,40,217,0.4); transform: translateY(-1px); }
        .btn-ghost { background: var(--surface); color: var(--text2); border-color: var(--border); }
        .btn-ghost:hover { background: var(--surface2); color: var(--text); border-color: var(--border2); }
        .btn-danger { background: rgba(239,68,68,0.1); color: #f87171; border-color: rgba(239,68,68,0.2); }
        .btn-danger:hover { background: rgba(239,68,68,0.18); }
        .btn-success { background: rgba(16,185,129,0.1); color: #6ee7b7; border-color: rgba(16,185,129,0.2); }
        .btn-success:hover { background: rgba(16,185,129,0.18); }

        /* ── Inputs ── */
        input, select, textarea {
            background: rgba(255,255,255,0.04) !important;
            border: 1px solid var(--border) !important;
            border-radius: 8px !important;
            color: var(--text) !important;
            font-size: 13.5px !important;
            padding: 9px 12px !important;
            outline: none !important;
            transition: border-color .18s, box-shadow .18s !important;
            font-family: 'Inter', sans-serif !important;
            width: 100%;
        }
        input:focus, select:focus, textarea:focus {
            border-color: rgba(139,92,246,0.5) !important;
            box-shadow: 0 0 0 3px rgba(139,92,246,0.1) !important;
        }
        input::placeholder, textarea::placeholder { color: var(--text3) !important; }
        select option { background: #1a1530; color: var(--text); }

        /* ── Tables ── */
        table { width: 100%; border-collapse: collapse; }
        th { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--text3); padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--border); }
        td { padding: 12px 14px; font-size: 13.5px; color: var(--text2); border-bottom: 1px solid rgba(255,255,255,0.03); }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: var(--surface); color: var(--text); }

        /* ── Status ── */
        .status-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
        .status-online  { background: var(--green); box-shadow: 0 0 6px rgba(16,185,129,0.5); }
        .status-offline { background: var(--red);   box-shadow: 0 0 6px rgba(239,68,68,0.4); }
        .status-idle    { background: var(--yellow); box-shadow: 0 0 6px rgba(245,158,11,0.4); }

        /* ── Alerts ── */
        .alert { padding: 12px 16px; border-radius: 10px; font-size: 13px; display: flex; align-items: flex-start; gap: 10px; margin-bottom: 14px; }
        .alert-success { background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.2); color: #6ee7b7; }
        .alert-danger  { background: rgba(239,68,68,0.08);  border: 1px solid rgba(239,68,68,0.2);  color: #fca5a5; }
        .alert-info    { background: rgba(139,92,246,0.08); border: 1px solid rgba(139,92,246,0.2); color: var(--accent2); }
        .alert-warning { background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2); color: #fcd34d; }

        /* ── Page header ── */
        .page-head { padding: 28px 24px 0; margin-bottom: 20px; }
        .page-title { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 600; color: #fff; display: flex; align-items: center; gap: 10px; }
        .page-sub   { font-size: 13px; color: var(--text2); margin-top: 4px; }
        .page-body  { padding: 0 24px 32px; }

        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.25); border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(139,92,246,0.4); }

        /* ── Loading bar ── */
        @keyframes loadbar { 0%{width:0} 100%{width:100%} }
        .og-loadbar { position: fixed; top: 0; left: 0; height: 2px; background: linear-gradient(90deg, #6d28d9, #8b5cf6, #c4b5fd); animation: loadbar .5s ease forwards; z-index: 9999; box-shadow: 0 0 10px rgba(139,92,246,0.6); }
    </style>
</head>
<body x-data="{ mob: false }">

    <!-- Video Background -->
    <% if (typeof settings !== 'undefined' && settings && settings.bgVideo) { %>
    <video id="og-bg-video" autoplay muted loop playsinline>
        <source src="/assets/bg-video.mp4" type="video/mp4">
    </video>
    <div class="og-bg-overlay"></div>
    <% } else { %>
    <div class="og-ambient"></div>
    <% } %>

    <div class="og-loadbar" id="og-loadbar"></div>

    <!-- Mobile header -->
    <div class="og-mobile-header">
        <button class="og-hamburger" @click="mob = !mob; document.getElementById('og-sidebar').classList.toggle('open')">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <span class="og-mobile-brand"><%= name %></span>
        <% if (typeof coins !== 'undefined') { %>
        <span style="font-size:12px;color:#fbbf24;background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.15);padding:4px 10px;border-radius:20px;font-weight:500;">
            <i class="fas fa-coins" style="margin-right:4px;"></i><%= coins %>
        </span>
        <% } %>
    </div>

    <!-- Sidebar overlay (mobile) -->
    <div class="og-sidebar-overlay" id="og-sidebar-overlay" @click="mob=false; document.getElementById('og-sidebar').classList.remove('open')"></div>

    <div class="og-layout">
        <!-- Sidebar -->
        <aside class="og-sidebar" id="og-sidebar">
            <div class="og-brand">
                <div class="og-brand-icon">
                    <% if (typeof settings !== 'undefined' && settings && settings.logo) { %>
                        <img src="/assets/logo.png" alt="Logo">
                    <% } else { %>
                        O
                    <% } %>
                </div>
                <span class="og-brand-name"><%= name %></span>
            </div>

            <% if (typeof coins !== 'undefined') { %>
            <div class="og-coins">
                <i class="fas fa-coins"></i> <%= coins %> coins
            </div>
            <% } %>

            <div class="og-nav-section">Main</div>

            <a href="/dashboard" class="og-nav-link" data-path="dashboard">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Dashboard
            </a>
            <a href="/servers" class="og-nav-link" data-path="servers">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                Servers
            </a>
            <a href="/create-server" class="og-nav-link" data-path="create-server">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Create Server
            </a>
            <a href="/credentials" class="og-nav-link" data-path="credentials">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                Credentials
            </a>

            <div class="og-nav-section">Extras</div>

            <a href="/afk" class="og-nav-link" data-path="afk">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                AFK Page
            </a>
            <a href="/store" class="og-nav-link" data-path="store">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                Store
            </a>
            <a href="/panel" class="og-nav-link" data-path="panel">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                Panel
            </a>

            <% if (typeof admin !== 'undefined' && admin == true) { %>
            <div class="og-nav-section">Admin</div>
            <a href="/admin" class="og-nav-link" data-path="admin">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Admin
                <span class="og-nav-badge">Admin</span>
            </a>
            <% } %>

            <!-- User card -->
            <div class="og-user-card" style="margin-top:16px;">
                <% if (typeof user !== 'undefined' && user) { %>
                <img class="og-user-avatar"
                    src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64"
                    onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'"
                    alt="avatar">
                <div style="flex:1;overflow:hidden">
                    <div class="og-user-name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= user.username %></div>
                    <div class="og-user-tag">#<%= user.discriminator || '0000' %></div>
                </div>
                <% } %>
                <a href="/logout" class="og-logout-btn" title="Logout">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </a>
            </div>
        </aside>

        <!-- Main content -->
        <main class="og-main" id="og-main">

    <script>
    // Active nav link
    (function(){
        var p = window.location.pathname.split('/').filter(Boolean).pop() || 'dashboard';
        document.querySelectorAll('.og-nav-link').forEach(function(a){
            var dp = a.getAttribute('data-path');
            if (dp && (p === dp || (p === '' && dp === 'dashboard'))) a.classList.add('active');
        });
    })();

    // Loading bar fade
    setTimeout(function(){
        var lb = document.getElementById('og-loadbar');
        if (lb) { lb.style.opacity='0'; lb.style.transition='opacity .4s'; }
    }, 600);

    // Video BG ready
    var vid = document.getElementById('og-bg-video');
    if (vid) {
        vid.addEventListener('loadeddata', function(){ vid.classList.add('ready'); });
        vid.load();
    }

    // Mobile sidebar
    document.addEventListener('click', function(e){
        var overlay = document.getElementById('og-sidebar-overlay');
        var sidebar = document.getElementById('og-sidebar');
        if (overlay && e.target === overlay) {
            sidebar.classList.remove('open');
            overlay.style.display = 'none';
        }
    });
    </script>
