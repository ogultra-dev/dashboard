<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= name %> — Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%236d28d9'/><text x='50%25' y='56%25' font-family='Arial' font-size='18' font-weight='bold' fill='white' text-anchor='middle' dominant-baseline='middle'>O</text></svg>">
    <style>
        *{box-sizing:border-box;margin:0;padding:0}

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #07060f;
            overflow: hidden;
            position: relative;
        }

        /* Video BG */
        #bg-video {
            position: fixed; inset: 0;
            width: 100%; height: 100%;
            object-fit: cover; z-index: 0;
            opacity: 0; transition: opacity 1.2s ease;
        }
        #bg-video.ready { opacity: 1; }

        /* Overlays */
        .overlay {
            position: fixed; inset: 0; z-index: 1;
            background: linear-gradient(135deg, rgba(7,6,15,0.85) 0%, rgba(20,8,40,0.8) 100%);
        }
        .glow1 { position: fixed; top: -25%; left: 50%; transform: translateX(-50%); width: 800px; height: 500px; background: radial-gradient(ellipse, rgba(109,40,217,0.18) 0%, transparent 70%); z-index: 2; pointer-events: none; }
        .glow2 { position: fixed; bottom: -10%; right: -5%; width: 500px; height: 500px; background: radial-gradient(ellipse, rgba(139,92,246,0.1) 0%, transparent 70%); z-index: 2; pointer-events: none; }

        /* Card */
        .card {
            position: relative; z-index: 10;
            width: 100%; max-width: 400px;
            background: rgba(13,11,26,0.78);
            border: 1px solid rgba(139,92,246,0.18);
            border-radius: 20px;
            padding: 38px 36px;
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            box-shadow: 0 32px 80px rgba(0,0,0,0.5), inset 0 0 0 0.5px rgba(139,92,246,0.08);
            animation: fadeup .65s ease forwards; opacity: 0;
        }
        @keyframes fadeup { to{opacity:1;transform:none} from{opacity:0;transform:translateY(18px)} }

        /* Brand */
        .brand { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 26px; }
        .brand-icon {
            width: 42px; height: 42px; border-radius: 11px;
            background: linear-gradient(135deg, #6d28d9, #8b5cf6);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; color: #fff;
            box-shadow: 0 0 24px rgba(139,92,246,0.4);
            overflow: hidden;
        }
        .brand-icon img { width: 100%; height: 100%; object-fit: cover; border-radius: 11px; }
        .brand-name {
            font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 19px;
            background: linear-gradient(90deg, #c4b5fd, #a78bfa);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }

        .title { font-family: 'Space Grotesk', sans-serif; font-size: 21px; font-weight: 600; color: #fff; text-align: center; margin-bottom: 4px; }
        .subtitle { font-size: 13px; color: rgba(150,135,200,0.5); text-align: center; margin-bottom: 28px; }

        /* Alert */
        .alert { padding: 11px 14px; border-radius: 10px; font-size: 13px; display: flex; gap: 8px; align-items: flex-start; margin-bottom: 18px; }
        .alert-err { background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); color: #fca5a5; }

        /* Discord btn */
        .btn-discord {
            display: flex; align-items: center; justify-content: center; gap: 10px;
            width: 100%; padding: 13px;
            background: #5865F2;
            border: none; border-radius: 10px;
            color: #fff; font-size: 14.5px; font-weight: 600;
            font-family: 'Inter', sans-serif; cursor: pointer;
            text-decoration: none;
            transition: all .2s;
            box-shadow: 0 4px 18px rgba(88,101,242,0.3);
        }
        .btn-discord:hover { background: #4752c4; box-shadow: 0 6px 26px rgba(88,101,242,0.45); transform: translateY(-1px); }
        .btn-discord svg { width: 20px; height: 20px; flex-shrink: 0; }

        /* Divider */
        .divider { display: flex; align-items: center; gap: 12px; margin: 16px 0; color: rgba(150,135,200,0.3); font-size: 12px; }
        .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,0.06); }

        /* Panel btn */
        .btn-panel {
            display: flex; align-items: center; justify-content: center; gap: 8px;
            width: 100%; padding: 11px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            color: rgba(200,185,255,0.8); font-size: 13.5px; font-weight: 500;
            font-family: 'Inter', sans-serif; cursor: pointer; text-decoration: none;
            transition: all .18s;
        }
        .btn-panel:hover { background: rgba(139,92,246,0.08); border-color: rgba(139,92,246,0.25); color: #c4b5fd; }

        /* Footer */
        .login-foot { margin-top: 22px; text-align: center; font-size: 11.5px; color: rgba(150,135,200,0.35); }
        .login-foot a { color: rgba(139,92,246,0.6); text-decoration: none; }
        .login-foot a:hover { color: var(#a78bfa); }

        /* Error badges */
        .err-banner { background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); border-radius: 10px; padding: 11px 14px; font-size: 13px; color: #fca5a5; margin-bottom: 16px; display: flex; align-items: flex-start; gap: 8px; }
    </style>
</head>
<body>
    <video id="bg-video" autoplay muted loop playsinline></video>
    <div class="overlay"></div>
    <div class="glow1"></div>
    <div class="glow2"></div>

    <div class="card">
        <div class="brand">
            <div class="brand-icon">O</div>
            <span class="brand-name"><%= name %></span>
        </div>
        <div class="title">Welcome Back</div>
        <div class="subtitle">Sign in to access your dashboard</div>

        <% if (req.query.err == "INTERNALERROR") { %>
        <div class="err-banner"><i class="fas fa-circle-exclamation"></i><span>Internal server error. Please try again.</span></div>
        <% } %>
        <% if (req.query.err == "BANNED") { %>
        <div class="err-banner"><i class="fas fa-ban"></i><span>Your account has been suspended. Reason: <%= req.query.reason %></span></div>
        <% } %>

        <a href="/login/discord" class="btn-discord">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            Continue with Discord
        </a>

        <div class="divider">or</div>

        <a href="/panel" class="btn-panel">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            Go to Panel
        </a>

        <div class="login-foot">
            &copy; <%= new Date().getFullYear() %> <%= name %> — All rights reserved<br>
            <a href="#">Terms</a> &middot; <a href="#">Privacy</a>
        </div>
    </div>

    <script>
        var vid = document.getElementById('bg-video');
        vid.addEventListener('loadeddata', function(){ vid.classList.add('ready'); });
        // Load video if available (set by admin)
        // vid.innerHTML = '<source src="/assets/bg-video.mp4" type="video/mp4">';
        // vid.load();
    </script>
</body>
</html>
